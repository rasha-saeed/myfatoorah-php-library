{
    "name": "myfatoorah/library",
    "description": "MyFatoorah PHP Library",
    "version": "2.2.11",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.0",
        "phan/phan": "^6.0"
    },
    "prefer-stable": true,
    "scripts": {
        "phpunit": "phpunit",
        "phan": "phan",
        "phpstan": [
            "phpstan analyse autoload.php --level 9",
            "phpstan analyse src/ --level 5",
            "phpstan analyse tests/ --level 5"
        ],
        "phpcs": [
            "phpcs",
            "phpcs -p --standard=PHPCompatibility autoload.php --runtime-set testVersion 7.0-",
            "phpcs -p --standard=PHPCompatibility src/ --runtime-set testVersion 7.0-",
            "phpcs -p --standard=PHPCompatibility tests/ --runtime-set testVersion 8.4-"
        ],
        "psr4": "@composer dump-autoload --optimize --strict-psr --dry-run",
        "phpcbf": [
            "phpcbf --standard=PSR12 autoload.php --exclude=Generic.Files.LineLength,PSR1.Files.SideEffects",
            "phpcbf --standard=PSR12 src/ --exclude=Generic.Files.LineLength",
            "phpcbf --standard=PSR12 tests/ --exclude=Generic.Files.LineLength"
        ],
        "check": [
            "@phpunit",
            "@phan",
            "@phpstan",
            "@phpcs",
            "@psr4"
        ]
    },
    "autoload": {
        "files": [
            "autoload.php"
        ],
        "psr-4": {
            "MyFatoorah\\Library\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyFatoorah\\Test\\": "tests"
        }
    },
    "keywords": [
        "MyFatoorah",
        "My Fatoorah",
        "Fatoorah",
        "gateway",
        "payment",
        "Shipping",
        "api",
        "commerce",
        "Library"
    ],
    "homepage": "https://myfatoorah.com/",
    "authors": [
        {
            "name": "MyFatoorah Plugin Team",
            "email": "tech@myfatoorah.com"
        },
        {
            "name": "Nermeen Shoman",
            "email": "nshoman@myfatoorah.com",
            "role": "Senior Software Engineer"
        },
        {
            "name": "Rasha Saeed",
            "email": "rsaeed@myfatoorah.com",
            "role": "Senior Software Engineer"
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
